;; Matches any expressions that preserve "truthiness".
;; i.e. If the input is zero it remains zero, and if it is nonzero it can have
;; a different value as long as it is still nonzero.
(decl pure multi truthy (Value) Value)
(rule (truthy (sextend _ x)) x)
(rule (truthy (uextend _ x)) x)
(rule (truthy (bmask _ x)) x)
(rule (truthy (ineg _ x)) x)
(rule (truthy (bswap _ x)) x)
(rule (truthy (bitrev _ x)) x)
(rule (truthy (popcnt _ x)) x)
(rule (truthy (rotl _ x _)) x)
(rule (truthy (rotr _ x _)) x)
(rule (truthy (select _ x (iconst_u _ (u64_when_non_zero)) (iconst_u _ 0))) x)

;; Temporary rust-compression experiment: collect suspected missing human rules
;; here for quick benchmarking.
(rule (simplify (select ty v t f))
      (if-let c (truthy v))
      (select ty c t f))

(rule (simplify
       (icmp ty cc k @ (iconst _ _) x))
      (icmp ty (intcc_swap_args cc) x k))

(rule (simplify
       (icmp result_ty
             cc
             (iconst ty k1)
             (iconst ty k2)))
      (subsume (iconst result_ty (imm64_icmp ty cc k1 k2))))

(rule (simplify (ireduce ty (iadd _ x y)))
      (iadd ty (ireduce ty x) (ireduce ty y)))

(rule (simplify (uextend (fits_in_64 wide) (iconst_u narrow k)))
      (subsume (iconst_u wide k)))

(rule (simplify
       (isub ty k @ (iconst ty _) x))
      (ineg ty (isub ty x k)))
