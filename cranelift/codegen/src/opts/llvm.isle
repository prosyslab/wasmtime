    (isub cty (iconst_s cty z) (iconst_s cty x))))
(rule
  (simplify (band ty
              (sle ty (iconst_s cty x) y)
              (bor ty
                (slt ty y (iconst_s cty z))
                (sle ty y (iconst_s cty z)))))
  (if-let true (i64_gt_eq z x))
  (ule ty
    (isub cty y (iconst_s cty x))
    (isub cty (iconst_s cty z) (iconst_s cty x))))
