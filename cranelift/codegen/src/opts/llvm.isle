              (slt ty (iconst_s cty x) (iadd cty y (iconst_s cty 1)))
              (select ty
                (ule _ (iconst_s cty x) (iconst_s cty z))
                (ne ty y (iconst_s cty z))
                (ne ty y (iconst_s cty z)))))
   (bor ty
     (sge ty (iconst_s cty z) (iconst_s cty x))
     (ult ty (iconst_s cty x) (iadd cty y (iconst_s cty 1)))))
