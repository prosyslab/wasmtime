              (sgt ty (iadd cty x (iconst_u cty 1)) (iconst_s cty y))
              (select ty
                (ugt _ (iconst_s cty y) (iconst_u cty z))
                (ne ty (iconst_u cty z) x)
                (ne ty x (iconst_u cty z)))))
   (bor ty
     (sge ty (iconst_u cty z) (iconst_s cty y))
     (slt ty (iconst_s cty y) (iadd cty x (iconst_s cty 1)))))
