              (band cty (iconst_s cty x) (imul cty (iconst_s cty y) z))
              (iconst_s cty x)))
  (if-let true (i64_eq y (i64_wrapping_mul x 11)))
(if-let true (i64_is_any_sign_power_of_two x))
(ne ty (band cty z (iconst_u cty 1)) (iconst_u cty 0)))
