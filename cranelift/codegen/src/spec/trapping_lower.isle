;;;; Lowering terms include the result Type, unlike optimization Inst terms.
(spec (udiv ty x y)
    (modifies clif_trap)
    (provide (= (:bits ty) (widthof result)) (udiv_semantics! x y result clif_trap)))
(instantiate udiv bv_binary_8_to_64)
(spec (sdiv ty x y)
    (modifies clif_trap)
    (provide (= (:bits ty) (widthof result)) (sdiv_semantics! x y result clif_trap)))
(instantiate sdiv bv_binary_8_to_64)
(spec (urem ty x y)
    (modifies clif_trap)
    (provide (= (:bits ty) (widthof result)) (urem_semantics! x y result clif_trap)))
(instantiate urem bv_binary_8_to_64)
(spec (srem ty x y)
    (modifies clif_trap)
    (provide (= (:bits ty) (widthof result)) (srem_semantics! x y result clif_trap)))
(instantiate srem bv_binary_8_to_64)
